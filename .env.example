# ============================================
# 每周人社资讯生成器 — 环境变量配置模板
# 复制本文件为 .env 后按实际环境修改
# ============================================

# --------------------------------------------
# 1. MySQL 数据库配置（必填）
# --------------------------------------------
# 格式：mysql+asyncmy://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+asyncmy://root:0000@127.0.0.1:3306/aitools

# --------------------------------------------
# 2. 新闻采集服务地址（必填）
# --------------------------------------------
# 新闻采集服务部署的 IP 地址（端口固定 4399）
# 若与本项目部署在同一台服务器，填 127.0.0.1
# 若部署在其他服务器，填对应内网/公网 IP
NEWS_API_HOST=127.0.0.1

# --------------------------------------------
# 3. AI 模型配置
# --------------------------------------------
# --- Qwen3 本地模型（默认使用，无需额外配置）---
QWEN3_API_URL=http://10.27.51.1:80/ai/v1/chat/completions
QWEN3_API_KEY=sk-ZKR2024@.com
QWEN3_MODEL_NAME=qwen3

# --- DeepSeek 云端模型（可选，用户也可在页面输入）---
# 管理员可在此处预配默认 Key，方便全员共用
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL_NAME=deepseek-chat
